/target
/vendor/rtk/target/
# Runtime artifacts (auto-created, never commit)
/.latte/sessions/
/.latte/traces/
/.latte/logs/
/.latte/checkpoints/
/.latte/worktrees/
/.latte/chat-saves/
/.latte/chat-sessions/
/.latte/ui-sessions/
/.latte/tasks/
.omc/
# Project-level config (committed):
#   .latte/agents/        — role TOML (id, tools, model_chain, etc.)
#   .latte/agents.d/      — alt role dir (legacy / global-convention layout)
#   .latte/prompts.d/     — system-prompt overrides
#   .latte/models.toml    — project-local model catalog
#   .latte/models.d/      — vendor-split model files
#   .latte/workflows/     — workflow TOML
# The two `!` lines below re-include these after the runtime
# ignores above, so a fresh `git clone` gets the same role /
# model config the project was developed with.
!.latte/agents/
!.latte/agents.d/
!.latte/prompts.d/
!.latte/models.toml
!.latte/models.d/
!.latte/workflows/
tests/.latte/
# Frontend (`latte-agent-cli/ui/`, Vite + React). Source-of-truth
# is the `.ts` files; `tsc` emits `.js` alongside and `vite build`
# produces `dist/`. `node_modules/` is npm install output.
latte-agent-cli/ui/node_modules/
latte-agent-cli/ui/dist/
latte-agent-cli/ui/src/*.js
latte-agent-cli/ui/self-loop/*.js
latte-agent-cli/ui/self-loop/tests/*.js
latte-agent-cli/ui/__tests__/*.js
# AI self-loop debug outputs. Run outputs (screenshots, probe PNGs)
# land inside any `**/.latte/self-loop/**` directory (root `.latte/`
# self-loop or nested `latte-agent-cli/ui/.latte/self-loop/`). Pattern
# is anchored to `.latte/` so it does NOT match the source dir
# `latte-agent-cli/ui/self-loop/` (which has `runner.ts`, tests, etc.).
**/.latte/self-loop/**
# Core dump files (generated by crashes, too large to commit)
core.*
core
